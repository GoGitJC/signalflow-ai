# =============================================================================
# SignalFlow AI — PRODUCTION environment template
# Copy values into Render / Vercel secret stores. Never commit real secrets.
# Replace <DOMAIN> with your registered domain (e.g. signalflow.ai).
# =============================================================================

# --- Backend (Render) --------------------------------------------------------
APP_ENV=production
SIGNALFLOW_ENVIRONMENT=production

# Render injects DATABASE_URL for managed Postgres; convert if needed:
# postgresql://…  →  postgresql+psycopg://…
SIGNALFLOW_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/signalflow

APP_PUBLIC_API_URL=https://api.<DOMAIN>
CORS_ORIGINS=https://www.<DOMAIN>,https://app.<DOMAIN>
SIGNALFLOW_FRONTEND_ORIGIN=https://www.<DOMAIN>
TRUSTED_HOSTS=api.<DOMAIN>,*.onrender.com

AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# Optional parent domain if you deliberately share cookies across subdomains:
# AUTH_COOKIE_DOMAIN=.<DOMAIN>

LOG_LEVEL=INFO
LOG_JSON=true
RATE_LIMIT_ENABLED=true

JWT_SECRET=replace-with-long-random-string
SIGNALFLOW_CREDENTIAL_ENCRYPTION_KEY=replace-with-fernet-key
OWNER_API_TOKEN=replace-with-bootstrap-token

INTEGRATION_MODE=live
ALLOW_LIVE_BOOKING=false

RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_AGENT_NAME=
RETELL_WEBHOOK_BASE_URL=https://api.<DOMAIN>
SIGNALFLOW_RETELL_WEBHOOK_SECRET=

CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_EVENT_TYPE_SLUG=
CALCOM_USERNAME=
SIGNALFLOW_CALCOM_WEBHOOK_SECRET=

SIGNALFLOW_TWILIO_ACCOUNT_SID=
SIGNALFLOW_TWILIO_AUTH_TOKEN=

# --- Frontend (Vercel) -------------------------------------------------------
# Set in Vercel Project → Settings → Environment Variables (Production)
VITE_API_URL=https://api.<DOMAIN>
# Leave empty in multi-tenant cookie auth; optional demo hint only:
VITE_BUSINESS_ID=
