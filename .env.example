# Application
SIGNALFLOW_ENVIRONMENT=development
# APP_ENV is an alias for SIGNALFLOW_ENVIRONMENT (use production in cloud)
SIGNALFLOW_FRONTEND_ORIGIN=http://localhost:5173
# Production example: CORS_ORIGINS=https://www.example.com,https://app.example.com
CORS_ORIGINS=
APP_PUBLIC_API_URL=http://localhost:8000
INTEGRATION_MODE=mock

# Database (Compose overrides this for the backend service)
SIGNALFLOW_DATABASE_URL=postgresql+psycopg://signalflow:signalflow@localhost:5432/signalflow

# Legacy mock toggle (INTEGRATION_MODE=mock sets this automatically)
SIGNALFLOW_MOCK_EXTERNAL_SERVICES=true

# Fernet key for encrypting stored provider credentials
SIGNALFLOW_CREDENTIAL_ENCRYPTION_KEY=

# Owner/admin token for bootstrap/CLI only (dashboard uses HttpOnly cookies)
OWNER_API_TOKEN=

# JWT cookie sessions — required for /api/auth
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
JWT_REFRESH_REMEMBER_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=

# Ops / production readiness
LOG_LEVEL=INFO
LOG_JSON=true
RATE_LIMIT_ENABLED=true
# TRUSTED_HOSTS=api.example.com,localhost

# Retell AI (live mode only — leave empty locally)
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_AGENT_NAME=Universal_Demo
RETELL_WEBHOOK_BASE_URL=
RETELL_WEBHOOK_SECRET=

# Cal.com API v2 (live mode only — leave empty locally)
CALCOM_API_KEY=
CALCOM_API_BASE_URL=https://api.cal.com/v2
CALCOM_API_VERSION=2024-09-04
CALCOM_EVENT_TYPE_ID=
CALCOM_EVENT_TYPE_SLUG=
CALCOM_USERNAME=

# Webhook HMAC secrets (empty = signature checks skipped in mock mode)
SIGNALFLOW_RETELL_WEBHOOK_SECRET=
SIGNALFLOW_CALCOM_WEBHOOK_SECRET=

# Twilio (unused while INTEGRATION_MODE=mock)
SIGNALFLOW_TWILIO_ACCOUNT_SID=
SIGNALFLOW_TWILIO_AUTH_TOKEN=

ALLOW_LIVE_BOOKING=false
CALCOM_EVENT_TYPES_API_VERSION=2024-06-14

# Frontend
VITE_API_URL=http://localhost:8000
VITE_BUSINESS_ID=
